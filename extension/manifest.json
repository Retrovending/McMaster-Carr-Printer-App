{
  "manifest_version": 3,
  "name": "Product → Label",
  "version": "1.4.0",
  "description": "Print McMaster-Carr and AutomationDirect product labels with DYMO or any browser-supported printer.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Print label for this product",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open the label popup"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.mcmaster.com/*",
    "https://*.mcmaster.com/*",
    "https://127.0.0.1:41951/*",
    "https://localhost:41951/*",
    "https://www.automationdirect.com/*",
    "https://automationdirect.com/*",
    "https://cdn.automationdirect.com/*"
  ]
}
